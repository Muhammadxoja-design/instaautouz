SMTP_USER=
EMAIL_FROM=

# AI Configuration
AI_DEFAULT_PROVIDER=gemini
AI_ENABLED=true

# WhatsApp
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=

# TikTok
