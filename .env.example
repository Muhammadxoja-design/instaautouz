# ------------------------
# SERVER ENV VARIABLES
# ------------------------
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/instaautouz
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Telegram Bot Setup
TELEGRAM_BOT_TOKEN=
