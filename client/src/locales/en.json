  "faq": {
    "title": "Frequently asked questions",
    "subtitle": "Answers to most common questions",
    "items": [
      {
        "q": "Is my data secure?",
        "a": "Yes, we use OAuth 2.0 protocol and never store your passwords. All data is stored encrypted."
      },
      {
        "q": "How many accounts can I connect?",
        "a": "Depending on your plan, you can connect from 1 to 10 accounts. The Business plan offers unlimited accounts."
      },
      {
        "q": "What payment methods are accepted?",
        "a": "We accept payments via Payme and Click. All transactions are processed through encrypted channels."
      },
      {
        "q": "How do auto-replies work?",
        "a": "We analyze DM messages using AI and respond based on keywords. You can create your own reply templates."
      }
    ]
  },
